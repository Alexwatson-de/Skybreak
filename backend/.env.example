# Native ENet is the default. Render uses GAME_TRANSPORT=websocket.
PORT=3000
GAME_TRANSPORT=websocket
PUBLIC_URL=http://127.0.0.1:3000
PUBLIC_GAME_HOST=127.0.0.1
WEB_URL=http://127.0.0.1:8123
ALLOWED_ORIGINS=http://127.0.0.1:8123
GAME_PORT_BASE=29500
MAX_ROOMS=2
# GODOT_BIN=/absolute/path/to/godot
# GAME_PATH=/absolute/path/to/game
# Render provides RENDER_EXTERNAL_URL if PUBLIC_URL is omitted.
